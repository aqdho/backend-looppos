const express = require("express");

const router = express.Router();

const authMiddleware = require("../middleware/authMiddleware");

const {
    createTransaksi,
    createPembayaran,
    createQrisPayment,
    simulateQrisPaid,
    getTransaksi,
    getTransaksiById,
    updateTransaksi,
    deleteTransaksi
} = require("../controllers/transaksiController");

router.post("/", createTransaksi);

router.post(
    "/pembayaran",
    authMiddleware,
    createPembayaran
);

router.post( 
    "/qris",
    authMiddleware, 
    createQrisPayment
);

router.post( 
    "/qris/:id/simulate-paid",
    authMiddleware,
    simulateQrisPaid
 );

router.get("/", authMiddleware, getTransaksi);

router.get("/:id", getTransaksiById);

router.put("/:id", updateTransaksi);

router.delete("/:id", deleteTransaksi);

module.exports = router;